{
  "schema": 4,
  "required_executas": [],
  "optional_executas": [],
  "tags": ["memory", "privacy", "productivity"],
  "system_prompt_addendum": "Nexora Memory is open. Never treat candidate memories as confirmed. Use only confirmed memories whose ai_access permits disclosure, and disclose the minimum task-relevant context.",
  "user_message_prefix_template": "[Nexora Memory] {user_message}",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Nexora Memory — Anna Edition",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 520 },
        "default_size": { "w": 960, "h": 720 },
        "max_size": { "w": 1440, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "icon": "icon.svg",
        "summary_template": "Nexora Memory: privacy-preserving memory review and access controls."
      }
    ],
    "browser_permissions": [],
    "csp_overrides": {
      "img-src": ["'self'", "data:"],
      "style-src": ["'self'"],
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins",
    "form_factors": ["desktop", "mobile"]
  },
  "dev": {
    "seed_storage": {},
    "user_id": 1
  }
}

